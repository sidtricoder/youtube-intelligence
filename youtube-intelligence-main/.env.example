# Run python scripts/bootstrap.py once to generate a private Fernet encryption key.
YT_DB_PATH=data/ytintel.db
YT_ENCRYPTION_KEY=
YT_YOUTUBE_API_KEY=
YT_GOOGLE_PROJECT_ID=
YT_GOOGLE_CLIENT_ID=
YT_GOOGLE_CLIENT_SECRET=
# Local configuration. On Render remove YT_REDIRECT_URI so the HTTPS callback is derived.
YT_LOCAL_BASE_URL=http://localhost:8000
YT_REDIRECT_URI=http://localhost:8000/oauth/callback
# Quota/rate budgets are enforced by Google only. Legacy YT_* quota settings are ignored.
# Only configured immediate proxy IPs/CIDRs may supply X-Forwarded-For. Empty trusts none.
YT_TRUSTED_PROXIES=
DATABASE_URL=
DATABASE_URL_POOLED=
YT_PUBLIC_BASE_URL=
