# Run python scripts/bootstrap.py to generate .env with real random local keys.
YT_DB_PATH=data/ytintel.db
YT_ENCRYPTION_KEY=
YT_API_KEY=
YT_OWNER_KEY=
# Optional. Lets Claude custom connectors (which cannot send headers) use https://host/mcp/?key=VALUE.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"  (>=32 chars, differs from other keys)
YT_MCP_URL_KEY=
YT_YOUTUBE_API_KEY=
YT_GOOGLE_PROJECT_ID=
YT_GOOGLE_CLIENT_ID=
YT_GOOGLE_CLIENT_SECRET=
YT_REDIRECT_URI=http://localhost:8000/oauth/callback
YT_UNITS_PER_DAY=10000
YT_SEARCHES_PER_DAY=100

# PostgreSQL on Neon: configure either URL; runtime prefers pooled when both are set.
DATABASE_URL=
DATABASE_URL_POOLED=
# Cloud only: optional HTTPS origin; Render supplies RENDER_EXTERNAL_URL automatically.
YT_PUBLIC_BASE_URL=
